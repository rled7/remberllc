{
  "name": "remberllc",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "pages:dev": "wrangler pages dev dist --port 8788",
    "demo:novo:build": "npm --prefix demo-src/novo ci && npm --prefix demo-src/novo run build && node scripts/sync-novo.mjs",
    "demo:dsa:build": "npm --prefix demo-src/dsa ci && npm --prefix demo-src/dsa run build:public && node scripts/sync-dsa.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241022.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.5.3",
    "vite": "^5.4.2",
    "wrangler": "^3.75.0"
  }
}

